{
  "name": "discord-bot",
  "version": "1.0.0",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "node scripts/clean-dist.cjs && tsc && npm run typecheck:strict",
    "typecheck:strict": "tsc -p tsconfig.strict.json",
    "start": "npm run build && node dist/index.js",
    "register": "npm run build && node dist/slash-commands.js",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "security:check": "npm run build && node dist/scripts/security-check.js",
    "service:install": "npm run build && node dist/scripts/install-service.js",
    "service:uninstall": "npm run build && node dist/scripts/uninstall-service.js"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.0",
    "better-sqlite3": "^13.0.3",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "node-windows": "^1.0.0-beta.8",
    "typescript": "^5.9.3"
  }
}